      "src": "./icons/taskflow-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/taskflow-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
